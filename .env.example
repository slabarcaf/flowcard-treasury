# Postgres database name
POSTGRES_DB=flowcard_treasury
# Postgres database user
POSTGRES_USER=flowcard
# Postgres database password
POSTGRES_PASSWORD=demo-local-only
# Compose ledger connection
DATABASE_URL=postgres://flowcard:demo-local-only@database:5432/flowcard_treasury
# Host Postgres connection
DATABASE_URL_HOST=postgres://flowcard:demo-local-only@localhost:5432/flowcard_treasury
# Node runtime environment
NODE_ENV=production
# Ledger HTTP port
PORT=3000
# Airwallex client ID
AIRWALLEX_CLIENT_ID=replace-with-sandbox-client-id
# Airwallex API credential
AIRWALLEX_API_KEY=replace-with-sandbox-api-key
# Airwallex webhook secret
AIRWALLEX_WEBHOOK_SECRET=replace-with-webhook-secret
# Airwallex API base URL
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Kit5 operator token
KIT5_OPERATOR_TOKEN=replace-with-a-local-token-at-least-32-characters
# Kit5 operator identity
KIT5_OPERATOR_ID=local-operator-placeholder
# Kit5 browser origins
KIT5_ALLOWED_ORIGINS=http://localhost:5173
# Restricted shortfall Compose connection, use a disposable logical database
SHORTFALL_DATABASE_URL=postgres://shortfall_local:synthetic-local-only@host.docker.internal:5432/shortfall_local
# Server-owned shortfall scope, never inferred from webhook fields
SHORTFALL_ENVIRONMENT=local
# Dedicated webhook source identity for durable deduplication
SHORTFALL_WEBHOOK_SOURCE=shortfall-local
# New host listener, Compose overrides this inside its own container
SHORTFALL_HTTP_ADDR=127.0.0.1:8082
# Dedicated shortfall webhook signing secret, synthetic example only
SHORTFALL_WEBHOOK_SECRET=synthetic-shortfall-webhook-secret
# Internal HS256 assertion secret, at least 32 bytes, synthetic example only
SHORTFALL_SERVICE_SECRET=synthetic-shortfall-service-secret-32-bytes
# Candidate issuing version, does not establish subscription compatibility
SHORTFALL_ISSUING_API_VERSION=2026-08-21
