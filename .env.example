# Postgres database name
POSTGRES_DB=flowcard_treasury
# Postgres database user
POSTGRES_USER=flowcard
# Postgres database password
POSTGRES_PASSWORD=demo-local-only
# Compose ledger connection
DATABASE_URL=postgres://flowcard:demo-local-only@database:5432/flowcard_treasury
# Host Postgres connection
DATABASE_URL_HOST=postgres://flowcard:demo-local-only@localhost:5432/flowcard_treasury
# Node runtime environment
NODE_ENV=production
# Ledger HTTP port
PORT=3000
# Airwallex client ID
AIRWALLEX_CLIENT_ID=replace-with-sandbox-client-id
# Airwallex API credential
AIRWALLEX_API_KEY=replace-with-sandbox-api-key
# Airwallex webhook secret
AIRWALLEX_WEBHOOK_SECRET=replace-with-webhook-secret
# Airwallex API base URL
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Remote authorization term
REMOTE_AUTH_REPAYMENT_TERM=asap
# Kit5 operator token
KIT5_OPERATOR_TOKEN=replace-with-a-local-token-at-least-32-characters
# Kit5 operator identity
KIT5_OPERATOR_ID=local-operator-placeholder
# Kit5 browser origins
KIT5_ALLOWED_ORIGINS=http://localhost:5173
# Nova Global Account ID
KIT5_NOVA_GLOBAL_ACCOUNT_ID=replace-with-verified-nova-global-account-id
# Nova connected account ID
KIT5_NOVA_GLOBAL_ACCOUNT_CONNECTED_ACCOUNT_ID=replace-with-verified-connected-account-id
# Nova account currency
KIT5_NOVA_GLOBAL_ACCOUNT_CURRENCY=USD
# Evidence reviewer identity
AI_EVIDENCE_REVIEWER_ID=replace-with-reviewer-identity
# Evidence review enabled
AI_EVIDENCE_REVIEW_ENABLED=true
# Salesforce snapshot mode
SALESFORCE_SNAPSHOT_MODE=demo
