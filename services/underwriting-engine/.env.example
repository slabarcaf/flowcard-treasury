# Host-side URL for demo import/evaluate commands.
DATABASE_URL=postgres://underwriting_demo_runtime:replace-with-local-password@127.0.0.1:5432/flowcard_underwriting_demo
# Compose-only DB URL, used inside the API/mock container via host.docker.internal.
UNDERWRITING_CONTAINER_DATABASE_URL=postgres://underwriting_demo_runtime:replace-with-local-password@host.docker.internal:5432/flowcard_underwriting_demo
# Synthetic demo mode and selected facility.
UNDERWRITING_MODE=DEMO
UNDERWRITING_FACILITY_ID=facility_underwriting_demo
# Host listener. Compose overrides this inside its isolated demo container.
UNDERWRITING_HTTP_ADDR=127.0.0.1:8083
# Use distinct random local values, each at least 32 bytes.
UNDERWRITING_SERVICE_SECRET=replace-with-random-underwriting-secret-at-least-32-bytes
SHORTFALL_SERVICE_SECRET=replace-with-different-shortfall-secret-at-least-32-bytes
# The host-run mock uses 8084; Compose runs the same mock in the API container.
SHORTFALL_BASE_URL=http://127.0.0.1:8084
