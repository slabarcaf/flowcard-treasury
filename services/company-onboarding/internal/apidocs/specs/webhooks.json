{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "param": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "field",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "InboundWebhookPayload": {
        "properties": {
          "accountId": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "data": {},
          "environment": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "UnauthenticatedResponse": {
        "description": "Internal webhook service JWT assertion failure response (HTTP 401)",
        "properties": {
          "code": {
            "example": "UNAUTHENTICATED",
            "type": "string"
          },
          "error": {
            "example": "unauthorized",
            "type": "string"
          },
          "message": {
            "example": "invalid or missing authentication token",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "WebhookAcknowledgeResponse": {
        "properties": {
          "eventId": {
            "type": "string"
          },
          "received": {
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ],
        "type": "object"
      },
      "WebhookErrorResponse": {
        "properties": {
          "error": {
            "example": "invalid json payload",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ProviderSignature": {
        "description": "Computed hex HMAC-SHA256(timestamp string + original body), using notification URL secret. Supply signature, never the shared secret.",
        "in": "header",
        "name": "x-signature",
        "type": "apiKey"
      },
      "WebhookServiceJWT": {
        "bearerFormat": "JWT",
        "description": "Internal service-to-service JWT assertion for webhook forwarding (Issuer: flowcard-node-proxy, Audience: flowcard-onboarding-webhooks, Subject: node-webhook-forwarder).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Direct provider intake verifies x-signature over x-timestamp and original body. Internal delivery paths separately require service JWT assertions with audience flowcard-onboarding-webhooks. Receipt is committed before acknowledgement; credentials are not interchangeable.",
    "title": "FlowCard Onboarding Webhook Receiver API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/webhooks/airwallex": {
      "post": {
        "description": "Path alias for /api/webhooks/airwallex with identical authentication, durability, and error semantics.",
        "operationId": "ingestAirwallexWebhookV1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundWebhookPayload"
              }
            }
          },
          "description": "Inbound webhook event delivery payload",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookAcknowledgeResponse"
                }
              }
            },
            "description": "Durable acknowledgement receipt"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Missing event ID, name, or invalid JSON"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedResponse"
                }
              }
            },
            "description": "Missing or invalid webhook forwarder JWT assertion"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Method not allowed (only POST accepted)",
            "headers": {
              "Allow": {
                "description": "POST",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Conflicting event content committed as evidence"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Webhook payload exceeds 1 MiB limit"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Failed to durably commit webhook to inbox"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Database unconfigured"
          }
        },
        "security": [
          {
            "WebhookServiceJWT": []
          }
        ],
        "summary": "Ingest Airwallex webhook (v1 alias)",
        "tags": [
          "Webhooks"
        ]
      }
    },
    "/api/webhooks/airwallex": {
      "post": {
        "description": "Internal receiver endpoint for Airwallex webhook events forwarded by the Node gateway proxy. Requires service-to-service JWT assertion with audience flowcard-onboarding-webhooks. Events are durably persisted to PostgreSQL before acknowledging with HTTP 200. Max body size 1 MiB. Errors return map[string]string{\"error\": \"...\"}.",
        "operationId": "ingestAirwallexWebhook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundWebhookPayload"
              }
            }
          },
          "description": "Inbound webhook event delivery payload",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookAcknowledgeResponse"
                }
              }
            },
            "description": "Durable acknowledgement receipt"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Missing event ID, name, or invalid JSON"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedResponse"
                }
              }
            },
            "description": "Missing or invalid webhook forwarder JWT assertion"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Method not allowed (only POST accepted)",
            "headers": {
              "Allow": {
                "description": "POST",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Conflicting event content committed as evidence"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Webhook payload exceeds 1 MiB limit"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Failed to durably commit webhook to inbox"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Database unconfigured"
          }
        },
        "security": [
          {
            "WebhookServiceJWT": []
          }
        ],
        "summary": "Ingest Airwallex platform webhook",
        "tags": [
          "Webhooks"
        ]
      }
    },
    "/webhooks/airwallex": {
      "post": {
        "description": "HMAC-SHA256 over the exact x-timestamp string followed by original request bytes. One timestamp/signature header each. Maximum body 10 MiB, future-only five-minute timestamp tolerance; old timestamps accepted. Body id/name required, duplicate JSON keys rejected. Server owns sandbox/production scope. Acknowledgement follows durable commit. No internal JWT substitutes for provider authentication.",
        "operationId": "receiveProviderOnboardingWebhook",
        "parameters": [
          {
            "description": "Unix milliseconds, as originally signed",
            "in": "header",
            "name": "x-timestamp",
            "required": true,
            "schema": {
              "maxLength": 19,
              "minLength": 1,
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundWebhookPayload"
              }
            }
          },
          "description": "Original provider JSON object; account.* or rfi.* only; no event-ID header fallback",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookAcknowledgeResponse"
                }
              }
            },
            "description": "Original receipt or unchanged duplicate committed durably"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Invalid object, fields, scope or timestamp"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Missing/invalid signature or timestamp too far ahead"
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Request body timed out"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Changed event ID payload stored as conflict evidence; unfinished work quarantined"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Event belongs to another service"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Body exceeds inclusive 10 MiB limit"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Receipt could not be committed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorResponse"
                }
              }
            },
            "description": "Intake secret/scope or repository unconfigured"
          }
        },
        "security": [
          {
            "ProviderSignature": []
          }
        ],
        "summary": "Receive signed provider account/RFI events",
        "tags": [
          "Webhooks"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Current environment (relative gateway or direct service)",
      "url": "/"
    }
  ]
}
