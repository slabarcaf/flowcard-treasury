# Restricted service runtime. Provisioning/migrations use a separate admin CLI.
DATABASE_URL=postgres://funding_runtime:REPLACE@127.0.0.1:54329/owned_database?sslmode=disable
SERVICING_MODE=SANDBOX
SERVICING_PROVIDER_MODE=AIRWALLEX_SANDBOX
SERVICING_PROVIDER_BASE_URL=https://api.sandbox.airwallex.com
SERVICING_FACILITY_ID=REPLACE_WITH_VERIFIED_INTERNAL_FACILITY
SERVICING_SOURCE_BINDING_ID=REPLACE_WITH_VERIFIED_INSTALLATION
# Read only server-side from the existing root .env. Never use VITE_ names.
AIRWALLEX_CLIENT_ID=REPLACE
AIRWALLEX_API_KEY=REPLACE
AIRWALLEX_ACCOUNT_ID=REPLACE_WITH_PLATFORM_LOGIN_CONTEXT
AIRWALLEX_WEBHOOK_SECRET=REPLACE_WITH_OWNED_SERVICING_SUBSCRIPTION_SECRET
# Private expiring profiles exported from actual scoped sandbox evidence.
SERVICING_SANDBOX_PAYMENT_CONTRACT_FILE=/private/path/shortfall-contract.json
SERVICING_SANDBOX_EXECUTION_CONTRACT_FILE=/private/path/execution-contract.json
# Independent explicit gates, all disabled by default.
SERVICING_SANDBOX_DELEGATION_ENABLED=false
SERVICING_LIVE_DISPATCH_ENABLED=false
SERVICING_SANDBOX_FUNDING_ENABLED=false
SERVICING_SANDBOX_COLLECTION_ENABLED=false
# Existing distinct server keys and upstream settings are documented in README.
SERVICING_OPERATOR_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
SERVICING_CUSTOMER_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
# Optional fixture-based owned PostgreSQL tests, never a provider acceptance flag.
FUNDING_TEST_ADMIN_URL_FILE=/private/path/local-test-admin-url.txt
