# Restricted runtime connection, no migration/provisioning authority.
DATABASE_URL=postgres://shortfall_runtime:REPLACE@127.0.0.1:54329/owned_database?sslmode=disable
SHORTFALL_ENVIRONMENT=SANDBOX
# Private expiring parser contract from the exact owned subscription/version.
SHORTFALL_SANDBOX_CONTRACT_FILE=/private/path/shortfall-contract.json
# Existing server-side Airwallex credentials, never browser environment values.
AIRWALLEX_CLIENT_ID=REPLACE
AIRWALLEX_API_KEY=REPLACE
AIRWALLEX_ACCOUNT_ID=REPLACE_WITH_PLATFORM_LOGIN_CONTEXT
AIRWALLEX_WEBHOOK_SECRET=REPLACE_WITH_OWNED_SHORTFALL_SUBSCRIPTION_SECRET
