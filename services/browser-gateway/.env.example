# Restricted runtime login, never the administrative URL.
DATABASE_URL=postgres://browser_runtime:REPLACE@127.0.0.1:54329/flowcard_browser?sslmode=disable
# Administrative CLI only. Do not inject into the API process.
BROWSER_GATEWAY_ADMIN_DATABASE_URL=postgres://browser_admin:REPLACE@127.0.0.1:54329/flowcard_browser?sslmode=disable
# Exact comma-separated HTTP origins, no whitespace, paths or wildcards.
BROWSER_GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
# Default loopback listener; cookies remain Secure by default.
BROWSER_GATEWAY_HTTP_ADDR=127.0.0.1:8094
# Optional local HTTP exception. Listener AND every origin must be loopback.
BROWSER_GATEWAY_ALLOW_LOOPBACK_HTTP=false
# Optional operator proxy, both settings present or both empty. No URL prefix.
BROWSER_GATEWAY_ONBOARDING_URL=
# Same existing >=32-byte ONBOARDING_SERVICE_SECRET, server-only, never VITE_.
BROWSER_GATEWAY_ONBOARDING_SECRET=
# Optional independent Coordinator read connection, paired origin and secret.
BROWSER_GATEWAY_COORDINATOR_URL=
# Existing COORDINATOR_READER_SECRET, server-only.
BROWSER_GATEWAY_COORDINATOR_READ_SECRET=
# Optional independent Funding/Collection read connection.
BROWSER_GATEWAY_SERVICING_URL=
# Existing SERVICING_COORDINATOR_SECRET for fixed coordinator-reader subject.
# This is NOT SERVICING_READER_SECRET (the underwriting-only read-model key).
BROWSER_GATEWAY_SERVICING_READ_SECRET=
# Optional tests only: private URL file for localhost:54329/postgres maintenance.
BROWSER_GATEWAY_TEST_ADMIN_URL_FILE=/private/path/to/test-admin-url.txt
