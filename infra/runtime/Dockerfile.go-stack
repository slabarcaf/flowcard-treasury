FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH=amd64
WORKDIR /workspace
COPY services/ ./services/
COPY infra/runtime/ ./infra/runtime/
RUN mkdir -p /out && \
    for module in browser-gateway company-onboarding shortfall-detection underwriting-engine funding-collection go-coordinator; do \
      mkdir -p "/out/$module"; \
      cd "/workspace/services/$module"; \
      for command in api migrate worker users bindings deploytool legacy-webhooks legacy-import; do \
        if [ -d "cmd/$command" ]; then \
          CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
            go build -mod=readonly -trimpath -ldflags='-s -w' -o "/out/$module/$command" "./cmd/$command" || exit 1; \
        fi; \
      done; \
    done

FROM alpine:3.22
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
RUN apk add --no-cache ca-certificates && \
    wget -qO /etc/ssl/certs/rds-global-bundle.pem \
      https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem && \
    test -s /etc/ssl/certs/rds-global-bundle.pem && \
    addgroup -S -g 10001 app && adduser -S -u 10001 -G app -s /sbin/nologin app
COPY --from=build /out/ /opt/flowcard/
COPY infra/runtime/go-stack.json /etc/flowcard/go-stack.json
COPY infra/runtime/migrate-go-stack.sh /opt/flowcard/migrate-go-stack.sh
RUN chmod 0555 /opt/flowcard/migrate-go-stack.sh
ENV PGSSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem
USER 10001:10001
EXPOSE 3000 8080 8082 8085
ENTRYPOINT ["/opt/flowcard/browser-gateway/api"]
