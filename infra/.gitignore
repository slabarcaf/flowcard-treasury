# OpenTofu / Terraform local directories and state files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tflock
backend-*.hcl

# Track container definitions even when a global rule ignores secrets directories.
!modules/secrets/
modules/secrets/*
!modules/secrets/main.tf
!modules/secrets/outputs.tf
!modules/secrets/variables.tf
!modules/secrets/versions.tf
